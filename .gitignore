# OS
Thumbs.db
desktop.ini
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Secrets / local config
.env
*.key
secrets.json

# 문서는 md로 커밋한다 (2026-08-05 결정, AGENTS.md §4) — PDF는 로컬 생성/공유용
*.pdf
# 같은 이유로 오피스 문서도 md로 변환해 커밋한다 (원본은 로컬 보관)
*.docx
*.pptx
*.xlsx
# 예외: 논문 원본 PDF는 출처 자료로 커밋 유지
!**/논문/**/*.pdf
# 단, 논문 폴더 안이라도 우리가 생성한 해설 PDF는 커밋하지 않는다
**/논문/**/\[해설\]*.pdf

# Public repository safety — 개인 단위 원자료에서 파생된 분석 Dataset·SAMPID split은 로컬에만 둔다.
data/result/datasets/*.parquet
data/result/splits/split_ids.csv
# 실험별 경로 — 위의 기존 경로도 이전 산출물 보호를 위해 그대로 둔다.
data/result/*/datasets/*.parquet
data/result/*/splits/split_ids.csv
data/result/*/models/*.joblib
